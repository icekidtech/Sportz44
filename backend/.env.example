# Sportz44 backend environment
ENVIRONMENT=development
HTTP_PORT=8080

# PostgreSQL (native service)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sportz44?sslmode=disable

# Redis (native service)
REDIS_URL=redis://localhost:6379

# API-Sports (bulk data: fixtures, squads, competitions — free tier 2022-2024)
API_SPORTS_KEY=your_api_sports_key
API_SPORTS_HOST=https://v3.football.api-sports.io

# ESPN (primary current-season provider: fixtures, live scores, events+assists,
# lineups, stats — no API key, no documented rate limit, ~140 leagues/cups)
# Leave ESPN_URL empty to use the default public endpoint.
ESPN_URL=https://site.api.espn.com/apis/site/v2/sports/soccer

# JWT
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=168h

# CORS (comma separated, or * for any)
ALLOWED_ORIGINS=*

# Trusted reverse-proxy IPs/CIDRs (comma separated). Empty = trust no proxy,
# so Gin uses the TCP peer address directly and ignores X-Forwarded-For.
# Set to your nginx IP in production (e.g. 127.0.0.1 if nginx is local).
TRUSTED_PROXIES=

# Rate limiting (per user/IP per window, per endpoint)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m

# Cookie domain for auth cookies (empty = host-only, e.g. api.sportz44.app)
COOKIE_DOMAIN=https://localhost:8080

# Initial admin (used by cmd/seed-admin)
ADMIN_EMAIL=admin@sportz44.app
ADMIN_PASSWORD=change_me

# Football-Data config
FOOTBALL_DATA_KEY=your_football_data_api_token
FOOTBALL_DATA_URL=https://api.football-data.org/v4
