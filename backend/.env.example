# Sportz44 backend environment
ENVIRONMENT=development
HTTP_PORT=8080

# PostgreSQL (native service)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sportz44?sslmode=disable

# Redis (native service)
REDIS_URL=redis://localhost:6379

# API-Sports (bulk data: fixtures, squads, competitions)
API_SPORTS_KEY=your_api_sports_key
API_SPORTS_HOST=https://v3.football.api-sports.io

# FlashScore (realtime live scores/events — unofficial JSON feed)
FLASHSCORE_URL=https://www.flashscore.com

# TheSportsDB (media enrichment: logos, photos, bios)
THESPORTSDB_KEY=your_thesportsdb_key
THESPORTSDB_URL=https://www.thesportsdb.com/api/v1/json

# JWT
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=168h

# CORS (comma separated, or * for any)
ALLOWED_ORIGINS=*

# Cookie domain for auth cookies (empty = host-only, e.g. api.sportz44.app)
COOKIE_DOMAIN=https://localhost:8080

# Initial admin (used by cmd/seed-admin)
ADMIN_EMAIL=admin@sportz44.app
ADMIN_PASSWORD=change_me

# Football-Data config
FOOTBALL_DATA_KEY=your_football_data_api_token
FOOTBALL_DATA_URL=https://api.football-data.org/v4
